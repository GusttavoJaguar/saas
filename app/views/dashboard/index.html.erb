<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Saas Landing Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="bg-dark text-light">
<h1 align="center">Dashboard</h1>

<div class="container d-flex justify-content-center align-items-center p-5" style="min-height: 23vh;">
    <b align="center" class="lead p-2">Quantidade de lojas: </b>

    <%= @stores_count %>
</div>

<div class="container d-flex justify-content-center align-items-center p-5" style="min-height: 23vh;">
    <%= link_to "Ir para a página pública", public_home_path, class: "btn btn-primary p-2 m-2" %>
    <%= link_to "Gerenciar minha loja", stores_path, class: "btn btn-secondary p-2 m-2" %>
    <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "btn btn-danger" %>
</div>

<div class="container mt-4">
    <h2 class="h5 mb-3">Minhas lojas</h2>
    <% @stores.each do |store| %>
        <div class="d-flex align-items-center justify-content-between mb-2">
            <div>
                <strong>@<%= store.name %></strong>
            </div>
            <div>
                <%= link_to "Ver loja pública", public_store_path(store), class: "btn btn-sm btn-outline-light me-2" %>
                <%= link_to "Gerenciar agendamentos e contatos", store_availabilities_path(store), class: "btn btn-sm btn-light" %>
            </div>
        </div>
    <% end %>
</div>
 

<footer class="text-center p-3" style="position: fixed; bottom: 0; width: 100%;">
  © 2026 Gusttavo Jaguar. Todos os direitos reservados.
</footer>
</body>
