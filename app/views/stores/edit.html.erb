<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Saas Landing Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  </head>

<% content_for :title, "Editing store" %>

<h1 class="text-center mt-5">Editar loja</h1>
<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
  <div class="w-100" style="max-width: 600px;">
  <%= render "form", store: @store %>
</div>
</div>
<br>

<% if @store.gallery_images.attached? %>
    <div class="mb-3">
      <label>Imagens da galeria atuais</label>
      <div class="row">
        <% @store.gallery_images.each_with_index do |img, index| %>
          <div class="col-md-4 mb-4">
          <div class="card shadow-sm border-0 h-100">
            <%= image_tag img,
              class: "card-img-top",
              style: "height: 250px; object-fit: cover;" %>
               <div class="form-check">
                <%= check_box_tag "remove_gallery[#{index}]", '1', false, class: "form-check-input" %>
               <br>
                <%= button_to "Remover foto", remove_gallery_image_store_path(@store, blob_id: img.blob_id), method: :delete, class: "btn btn-danger btn-sm", data: { confirm: "Tem certeza?" } %>
              </div>
          </div>
        </div>
        <% end %>
      </div>
    </div>
  <% end %>


<div>
  <%= link_to "Show this store", @store, class: "btn btn-primary" %> |
  <%= link_to "Back to stores", stores_path, class: "btn btn-secondary" %>
</div>
